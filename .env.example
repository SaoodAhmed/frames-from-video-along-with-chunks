# ─────────────────────────────────────────────────────────────
# FrameForge environment variables (copy to .env / .dev.vars)
# NEVER commit real values. Use placeholders here.
# ─────────────────────────────────────────────────────────────

# Cloudflare account
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CF_ACCOUNT_ID=a6e4f26a0af1d7591488bdd3f552a5e3

# R2 (object storage) — S3-compatible credentials for presigned URLs
R2_ACCOUNT_ID=a6e4f26a0af1d7591488bdd3f552a5e3
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=photos-from-video
R2_ENDPOINT=https://a6e4f26a0af1d7591488bdd3f552a5e3.r2.cloudflarestorage.com

# D1 (metadata database)
D1_DATABASE_ID=81a5cf89-ac9c-4d0d-9c30-5829021f4215

# Worker secrets
AUTH_SECRET=generate_a_long_random_string
ADMIN_SETUP_TOKEN=one_time_token_to_bootstrap_admin

# Processing limits
MAX_UPLOAD_SIZE=2147483648
MAX_FRAMES=5000

# ─────────────────────────────────────────────────────────────
# Python processor (Modal) secrets
# ─────────────────────────────────────────────────────────────
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret
PROCESSOR_R2_ACCOUNT_ID=a6e4f26a0af1d7591488bdd3f552a5e3
PROCESSOR_R2_ACCESS_KEY_ID=your_r2_access_key_id
PROCESSOR_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
PROCESSOR_R2_BUCKET=photos-from-video
PROCESSOR_R2_ENDPOINT=https://a6e4f26a0af1d7591488bdd3f552a5e3.r2.cloudflarestorage.com
PROCESSOR_D1_ACCOUNT_ID=a6e4f26a0af1d7591488bdd3f552a5e3
PROCESSOR_D1_API_TOKEN=your_d1_api_token_or_workers_key
